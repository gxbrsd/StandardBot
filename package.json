{
  "name": "standardbot",
  "version": "1.0.0",
  "type": "module",
  "description": "Modular Discord bot built with TypeScript and discord.js for moderation, tickets, server models, rules and welcome messages.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:global": "tsx src/deploy-commands.ts --global"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discordjs",
    "typescript",
    "moderation",
    "tickets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
